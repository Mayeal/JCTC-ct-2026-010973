$compass
title
CH2O
basis
aug-cc-pVTZ
geometry
        C              0.0000000000         0.0000000000        -0.9898897512
        O              0.0000000000         0.0000000000         1.2590015543
        H             -1.8503676573         0.0000000000        -2.0663369637
        H              1.8503676573         0.0000000000        -2.0663369637
end geometry
unit
bohr
$end

$xuanyuan
$end

$scf
uks
dft
b3lyp
charge
1
spinmulti
2
threshconv # SCF convergence criteria: first number - energy, second number - density matrix
1.d-10 1.d-8
grid
ultra fine
gridtol # tolerance for self-adaptive grid generation
1.d-9
$end

$tddft
iroot # number of excited state for EACH IRREP. We need max. 3 states per irrep, so set 4 to be on the safe side
4
crit_e # TDDFT energy convergence threshold
1.d-10
crit_vec # TDDFT excitation vector convergence threshold
1.d-8
istore
1
grid
ultra fine
gridtol
1.d-9
$end

# This block calculates all ge NACMEs
$resp
iprt
3
quad
fnac
single
norder
1
method
2
nfiles
1
states
7 # note: use PairSym, not ExSym!
1 2 1 # 1B2
1 3 1 # 1A1
1 2 2 # 2B2
1 1 1 # 2B1 (ground state is 1B1)
1 1 2 # 3B1
1 4 1 # 1A2
1 2 3 # 3B2
ignore # ignore Wmo skewness checks. In sufficient new BDF versions this should be redundant
1
grid
ultra fine
rtol # Z-vector convergence threshold
1.d-12
gridtol
1.d-9
$end

# This calculates all ee NACMEs
